# Local settings and secrets for experiments. Copy to .env (git-ignored) and fill in:
#
#   cp .env.example .env
#
# Experiments load .env automatically at startup. Variables already set in your
# shell take precedence over this file. Never put secrets in config.yaml: it is
# copied into every run dir and uploaded to MLflow.

# --- MLflow tracking (required unless you pass --no-track) ----------------------
# Server URL. Over plain HTTP the Host header includes the port, so the server's
# --allowed-hosts needs e.g. localhost:* for http://localhost:17005 to be accepted.
MLFLOW_TRACKING_URI=http://localhost:17005

# Credentials, if the server runs MLflow's basic-auth app (--app-name basic-auth)
# or sits behind a proxy with basic auth. Leave empty for an open server.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- llama.cpp (optional) -------------------------------------------------------
# Server command; default is llama-server if on PATH, otherwise `llama serve`.
# LLAMA_SERVER="llama serve"

# Hugging Face token, for gated or private models fetched with -hf.
# HF_TOKEN=

# --- Hosted endpoints (optional) ------------------------------------------------
# API keys named by an endpoint's api_key_env in config.yaml, e.g. a frontier judge.
# CEILING_API_KEY=
